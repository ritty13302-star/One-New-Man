<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#5b5ce2">
<title>世界地理大冒險｜國旗・國家・首都測驗</title>
<style>
:root{--ink:#20213b;--muted:#73758f;--purple:#5b5ce2;--pink:#ff6fae;--yellow:#ffd166;--mint:#67d9bd;--paper:#f7f7ff;--line:#e8e8f4;--white:#fff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% 5%,#e9e8ff 0,transparent 30%),radial-gradient(circle at 90% 20%,#ffe6f1 0,transparent 28%),var(--paper);font-family:ui-rounded,"Noto Sans TC","PingFang TC",system-ui,sans-serif;color:var(--ink);min-height:100vh}
button{font:inherit;cursor:pointer}.wrap{max-width:1000px;margin:auto;padding:22px 18px 50px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:24px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.3px}.brand-mark{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--purple),#8985ff);display:grid;place-items:center;color:#fff;font-size:23px;box-shadow:0 7px 18px #5b5ce244}.pill{background:#fff;border:1px solid var(--line);border-radius:99px;padding:9px 14px;color:var(--muted);font-size:13px;font-weight:700}
.hero{text-align:center;padding:24px 10px 20px}.eyebrow{display:inline-flex;gap:7px;align-items:center;background:#eeedff;color:var(--purple);padding:7px 13px;border-radius:99px;font-size:12px;font-weight:900}.hero h1{font-size:clamp(32px,6vw,54px);line-height:1.12;margin:17px 0 10px;font-weight:1000;letter-spacing:-1.5px}.hero h1 span{color:var(--purple)}.hero p{color:var(--muted);margin:0;font-size:15px}
.panel{background:#fff;border:1px solid var(--line);border-radius:26px;padding:25px;box-shadow:0 16px 45px #34346b0d}.setup{max-width:780px;margin:12px auto}.section-title{font-weight:900;margin:0 0 13px;font-size:16px}.modes{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.mode{border:2px solid var(--line);border-radius:17px;background:#fff;padding:14px 8px;text-align:center;color:var(--ink);transition:.15s}.mode:hover{transform:translateY(-2px);border-color:#c6c5ff}.mode.active{border-color:var(--purple);background:#f2f1ff;box-shadow:0 5px 14px #5b5ce21c}.mode .emoji{font-size:26px;display:block;margin-bottom:7px}.mode b{display:block;font-size:14px}.mode small{display:block;color:var(--muted);font-size:11px;margin-top:4px}
.options{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:24px}.choice-row{display:flex;gap:8px;flex-wrap:wrap}.chip{border:1.5px solid var(--line);background:#fff;border-radius:12px;padding:9px 14px;color:var(--muted);font-weight:800;font-size:13px}.chip.active{background:#eeedff;border-color:var(--purple);color:var(--purple)}.start{width:100%;border:0;border-radius:16px;padding:16px;background:linear-gradient(100deg,var(--purple),#8581ff);color:#fff;font-size:17px;font-weight:900;margin-top:27px;box-shadow:0 9px 20px #5b5ce23b}.start:hover{filter:brightness(1.05);transform:translateY(-1px)}.note{text-align:center;color:var(--muted);font-size:12px;margin:14px 0 0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 0 17px}.stat{background:#fff;border:1px solid var(--line);border-radius:15px;padding:12px;text-align:center}.stat small{display:block;color:var(--muted);font-size:11px;font-weight:700}.stat strong{font-size:20px;font-weight:950}
.quiz{max-width:780px;margin:0 auto}.quiz-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.progress{height:9px;background:#ececf6;border-radius:99px;overflow:hidden;margin:0 0 20px}.progress>div{height:100%;background:linear-gradient(90deg,var(--purple),var(--pink));border-radius:99px;transition:width .25s}.question-card{text-align:center;padding:28px 20px 22px}.q-label{font-size:12px;color:var(--muted);font-weight:900;letter-spacing:1px}.prompt{min-height:145px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;padding:14px}.flag-prompt{font-size:clamp(76px,17vw,120px);line-height:1.2;filter:drop-shadow(0 6px 5px #00000012)}.country-prompt{font-size:clamp(26px,6vw,42px);font-weight:1000}.capital-prompt{font-size:clamp(24px,5vw,36px);font-weight:1000;color:var(--purple)}.prompt-sub{color:var(--muted);font-size:13px}.answers{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:15px}.answer{border:2px solid var(--line);background:#fff;border-radius:15px;padding:15px 12px;min-height:60px;font-weight:850;color:var(--ink);font-size:15px;transition:.12s}.answer:hover:not(:disabled){border-color:#aaa8ff;background:#f8f7ff;transform:translateY(-1px)}.answer.correct{border-color:#26bd91;background:#e9fff7;color:#087b5b}.answer.wrong{border-color:#ff7192;background:#fff0f4;color:#c52d58}.answer:disabled{cursor:default}.feedback{margin-top:15px;border-radius:15px;padding:13px 15px;text-align:left;font-size:14px;font-weight:750;display:none}.feedback.show{display:block}.feedback.good{background:#eafff6;color:#087b5b}.feedback.bad{background:#fff0f4;color:#b52b52}.next{width:100%;border:0;background:var(--ink);color:#fff;border-radius:14px;padding:15px;font-weight:900;margin-top:14px;display:none}.next.show{display:block}
.result{text-align:center;max-width:780px;margin:0 auto}.trophy{font-size:70px}.result h2{font-size:32px;margin:8px 0}.score{font-size:56px;font-weight:1000;color:var(--purple);line-height:1.2}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}.result-grid .stat strong{font-size:22px}.actions{display:flex;gap:10px}.actions button{flex:1}.secondary{border:1.5px solid var(--line);background:#fff;border-radius:14px;padding:14px;font-weight:850;color:var(--ink)}.review{margin-top:20px;text-align:left}.review h3{font-size:16px}.wrong-item{padding:11px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;font-size:13px}.wrong-item b{color:#c52d58}.hidden{display:none!important}.footer{text-align:center;color:#a0a0b5;font-size:11px;margin-top:28px}
@media(max-width:600px){.wrap{padding:14px 12px 35px}.top{margin-bottom:10px}.hero{padding:20px 5px 15px}.panel{padding:18px;border-radius:21px}.modes{grid-template-columns:1fr 1fr}.options{grid-template-columns:1fr;gap:18px;margin-top:20px}.answers{grid-template-columns:1fr 1fr;gap:8px}.answer{font-size:14px;padding:12px 7px;min-height:58px}.question-card{padding:20px 13px}.actions{flex-direction:column}.pill{font-size:11px;padding:8px 10px}}
</style>
</head>
<body>
<div class="wrap">
<header class="top"><div class="brand"><div class="brand-mark">🌍</div><span>世界地理大冒險</span></div><div class="pill">🏆 挑戰你的地理腦</div></header>
<main>
<section id="home">
<div class="hero"><div class="eyebrow">✦ PLAY · LEARN · EXPLORE ✦</div><h1>環遊世界，<span>挑戰知識！</span></h1><p>認識國旗、國家與首都，看看你是世界地理達人嗎？</p></div>
<div class="panel setup">
<p class="section-title">🎯 選擇挑戰模式</p>
<div class="modes">
<button class="mode active" data-mode="flag"><span class="emoji">🏳️</span><b>國旗辨認</b><small>看國旗猜國家</small></button>
<button class="mode" data-mode="capital"><span class="emoji">🏙️</span><b>首都挑戰</b><small>看國家猜首都</small></button>
<button class="mode" data-mode="country"><span class="emoji">🗺️</span><b>國家辨認</b><small>看首都猜國家</small></button>
<button class="mode" data-mode="mixed"><span class="emoji">🎲</span><b>綜合挑戰</b><small>三種題型混合</small></button>
</div>
<div class="options">
<div><p class="section-title">⚡ 挑戰難度</p><div class="choice-row" id="difficulty"><button class="chip active" data-value="easy">入門</button><button class="chip" data-value="normal">進階</button><button class="chip" data-value="hard">高手</button></div></div>
<div><p class="section-title">📝 挑戰題數</p><div class="choice-row" id="count"><button class="chip active" data-value="10">10 題</button><button class="chip" data-value="20">20 題</button><button class="chip" data-value="50">50 題</button><button class="chip" data-value="all">全部</button></div></div>
</div>
<button class="start" id="start">開始冒險！ 🚀</button><p class="note">內含 230 個國家與地區資料 · 不需註冊 · 成績保存在此裝置</p>
</div>
</section>
<section id="playing" class="quiz hidden">
<div class="stats"><div class="stat"><small>目前題數</small><strong id="counter">1 / 10</strong></div><div class="stat"><small>目前得分</small><strong id="score">0</strong></div><div class="stat"><small>連續答對</small><strong id="streak">0 🔥</strong></div></div>
<div class="quiz-head"><span class="pill" id="modeLabel">🏳️ 國旗辨認</span><span class="pill" id="timer">⏱ 00:00</span></div>
<div class="progress"><div id="bar" style="width:0%"></div></div>
<div class="panel question-card">
<div class="q-label" id="qLabel">請選出正確答案</div><div class="prompt" id="prompt"></div>
<div class="answers" id="answers"></div>
<div id="feedback" class="feedback"></div><button id="next" class="next">下一題 →</button>
</div>
</section>
<section id="results" class="result hidden">
<div class="panel">
<div class="trophy" id="trophy">🏆</div><h2 id="resultTitle">挑戰完成！</h2><div class="score" id="finalScore">0 分</div><p id="resultSub" style="color:var(--muted)">繼續努力，你會越來越厲害！</p>
<div class="result-grid"><div class="stat"><small>答對題數</small><strong id="correctCount">0</strong></div><div class="stat"><small>正確率</small><strong id="accuracy">0%</strong></div><div class="stat"><small>完成時間</small><strong id="duration">00:00</strong></div></div>
<div class="actions"><button class="start" id="retry" style="margin:0">再玩一次 🔄</button><button class="secondary" id="homeBtn">回首頁</button></div>
<div class="review" id="review"></div>
</div>
</section>
</main>
<div class="footer">WORLD GEOGRAPHY QUEST · 探索世界，從認識每個國家開始</div>
</div>
<script>
const COUNTRIES = [{"code": "BT", "name": "不丹", "en": "Bhutan", "capital": "Thimphu"}, {"code": "CN", "name": "中國", "en": "China", "capital": "Beijing"}, {"code": "HK", "name": "中國香港特別行政區", "en": "Hong Kong", "capital": "City of Victoria"}, {"code": "CF", "name": "中非共和國", "en": "Central African Republic", "capital": "Bangui"}, {"code": "DK", "name": "丹麥", "en": "Denmark", "capital": "Copenhagen"}, {"code": "AZ", "name": "亞塞拜然", "en": "Azerbaijan", "capital": "Baku"}, {"code": "AM", "name": "亞美尼亞", "en": "Armenia", "capital": "Yerevan"}, {"code": "IL", "name": "以色列", "en": "Israel", "capital": "Jerusalem"}, {"code": "IQ", "name": "伊拉克", "en": "Iraq", "capital": "Baghdad"}, {"code": "IR", "name": "伊朗", "en": "Iran", "capital": "Tehran"}, {"code": "RU", "name": "俄羅斯", "en": "Russia", "capital": "Moscow"}, {"code": "BG", "name": "保加利亞", "en": "Bulgaria", "capital": "Sofia"}, {"code": "HR", "name": "克羅埃西亞", "en": "Croatia", "capital": "Zagreb"}, {"code": "IS", "name": "冰島", "en": "Iceland", "capital": "Reykjavik"}, {"code": "LI", "name": "列支敦斯登", "en": "Liechtenstein", "capital": "Vaduz"}, {"code": "LY", "name": "利比亞", "en": "Libya", "capital": "Tripoli"}, {"code": "CG", "name": "剛果共和國", "en": "Republic of the Congo", "capital": "Brazzaville"}, {"code": "CD", "name": "剛果民主共和國", "en": "Democratic Republic of the Congo", "capital": "Kinshasa"}, {"code": "GA", "name": "加彭", "en": "Gabon", "capital": "Libreville"}, {"code": "CA", "name": "加拿大", "en": "Canada", "capital": "Ottawa"}, {"code": "HU", "name": "匈牙利", "en": "Hungary", "capital": "Budapest"}, {"code": "KP", "name": "北韓", "en": "North Korea", "capital": "Pyongyang"}, {"code": "MK", "name": "北馬其頓", "en": "Republic of Macedonia", "capital": "Skopje"}, {"code": "MP", "name": "北馬利安納群島", "en": "Northern Mariana Islands", "capital": "Saipan"}, {"code": "TT", "name": "千里達及托巴哥", "en": "Trinidad and Tobago", "capital": "Port of Spain"}, {"code": "GS", "name": "南喬治亞與南三明治群島", "en": "South Georgia", "capital": "King Edward Point