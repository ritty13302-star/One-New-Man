 "Lisbon"}, {"code": "MN", "name": "蒙古", "en": "Mongolia", "capital": "Ulan Bator"}, {"code": "MS", "name": "蒙哲臘", "en": "Montserrat", "capital": "Plymouth"}, {"code": "BI", "name": "蒲隆地", "en": "Burundi", "capital": "Bujumbura"}, {"code": "GY", "name": "蓋亞那", "en": "Guyana", "capital": "Georgetown"}, {"code": "WS", "name": "薩摩亞", "en": "Samoa", "capital": "Apia"}, {"code": "SV", "name": "薩爾瓦多", "en": "El Salvador", "capital": "San Salvador"}, {"code": "SD", "name": "蘇丹", "en": "Sudan", "capital": "Khartoum"}, {"code": "SR", "name": "蘇利南", "en": "Suriname", "capital": "Paramaribo"}, {"code": "ET", "name": "衣索比亞", "en": "Ethiopia", "capital": "Addis Ababa"}, {"code": "EH", "name": "西撒哈拉", "en": "Western Sahara", "capital": "El Aaiún"}, {"code": "ES", "name": "西班牙", "en": "Spain", "capital": "Madrid"}, {"code": "NF", "name": "諾福克島", "en": "Norfolk Island", "capital": "Kingston"}, {"code": "NR", "name": "諾魯", "en": "Nauru", "capital": "Yaren"}, {"code": "CI", "name": "象牙海岸", "en": "Ivory Coast", "capital": "Yamoussoukro"}, {"code": "BJ", "name": "貝南", "en": "Benin", "capital": "Porto-Novo"}, {"code": "BZ", "name": "貝里斯", "en": "Belize", "capital": "Belmopan"}, {"code": "LR", "name": "賴比瑞亞", "en": "Liberia", "capital": "Monrovia"}, {"code": "LS", "name": "賴索托", "en": "Lesotho", "capital": "Maseru"}, {"code": "CY", "name": "賽普勒斯", "en": "Cyprus", "capital": "Nicosia"}, {"code": "GQ", "name": "赤道幾內亞", "en": "Equatorial Guinea", "capital": "Malabo"}, {"code": "VN", "name": "越南", "en": "Vietnam", "capital": "Hanoi"}, {"code": "ZW", "name": "辛巴威", "en": "Zimbabwe", "capital": "Harare"}, {"code": "GH", "name": "迦納", "en": "Ghana", "capital": "Accra"}, {"code": "KY", "name": "開曼群島", "en": "Cayman Islands", "capital": "George Town"}, {"code": "GU", "name": "關島", "en": "Guam", "capital": "Hagåtña"}, {"code": "AF", "name": "阿富汗", "en": "Afghanistan", "capital": "Kabul"}, {"code": "AE", "name": "阿拉伯聯合大公國", "en": "United Arab Emirates", "capital": "Abu Dhabi"}, {"code": "OM", "name": "阿曼", "en": "Oman", "capital": "Muscat"}, {"code": "AR", "name": "阿根廷", "en": "Argentina", "capital": "Buenos Aires"}, {"code": "DZ", "name": "阿爾及利亞", "en": "Algeria", "capital": "Algiers"}, {"code": "AL", "name": "阿爾巴尼亞", "en": "Albania", "capital": "Tirana"}, {"code": "KR", "name": "韓國", "en": "South Korea", "capital": "Seoul"}, {"code": "MQ", "name": "馬丁尼克", "en": "Martinique", "capital": "Fort-de-France"}, {"code": "MY", "name": "馬來西亞", "en": "Malaysia", "capital": "Kuala Lumpur"}, {"code": "ML", "name": "馬利", "en": "Mali", "capital": "Bamako"}, {"code": "MW", "name": "馬拉威", "en": "Malawi", "capital": "Lilongwe"}, {"code": "MT", "name": "馬爾他", "en": "Malta", "capital": "Valletta"}, {"code": "MV", "name": "馬爾地夫", "en": "Maldives", "capital": "Malé"}, {"code": "YT", "name": "馬約特島", "en": "Mayotte", "capital": "Mamoudzou"}, {"code": "MH", "name": "馬紹爾群島", "en": "Marshall Islands", "capital": "Majuro"}, {"code": "MG", "name": "馬達加斯加", "en": "Madagascar", "capital": "Antananarivo"}, {"code": "LB", "name": "黎巴嫩", "en": "Lebanon", "capital": "Beirut"}];
const flag = code => [...code.toUpperCase()].map(c=>String.fromCodePoint(127397+c.charCodeAt(0))).join('');
const $ = id => document.getElementById(id);
let selectedMode='flag', difficulty='easy', count='10', deck=[], index=0, score=0, streak=0, wrong=[], startAt=0, timerId=null, locked=false, current=null, correct=0;
const modes={flag:'🏳️ 國旗辨認',capital:'🏙️ 首都挑戰',country:'🗺️ 國家辨認',mixed:'🎲 綜合挑戰'};
document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.mode').forEach(x=>x.classList.remove('active'));b.classList.add('active');selectedMode=b.dataset.mode}));
function bindChips(id, setter){document.querySelectorAll('#'+id+' .chip').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('#'+id+' .chip').forEach(x=>x.classList.remove('active'));b.classList.add('active');setter(b.dataset.value)}))}
bindChips('difficulty',v=>difficulty=v);bindChips('count',v=>count=v);
const shuffle=a=>{let x=[...a];for(let i=x.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}return x};
function startGame(){const pool=shuffle(COUNTRIES);const n=count==='all'?pool.length:Math.min(+count,pool.length);deck=pool.slice(0,n).map(c=>({...c,type:selectedMode==='mixed'?shuffle(['flag','capital','country'])[0]:selectedMode}));index=0;score=0;streak=0;correct=0;wrong=[];startAt=Date.now();$('home').classList.add('hidden');$('results').classList.add('hidden');$('playing').classList.remove('hidden');$('modeLabel').textContent=modes[selectedMode];clearInterval(timerId);timerId=setInterval(updateTimer,1000);renderQuestion()}
function updateTimer(){$('timer').textContent='⏱ '+formatTime(Math.floor((Date.now()-startAt)/1000))}
function formatTime(s){return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
function makeQuestion(c){let type=c.type, prompt='',sub='',answer='',label='請選出正確答案';
if(type==='flag'){prompt=`<div class="flag-prompt">${flag(c.code)}</div>`;sub='這面國旗屬於哪個國家？';answer=c.name;label='🏳️ 國旗辨認'}
if(type==='capital'){prompt=`<div class="country-prompt">${c.name}</div>`;sub='這個國家的首都是哪裡？';answer=c.capital;label='🏙️ 首都挑戰'}
if(type==='country'){prompt=`<div class="capital-prompt">${c.capital}</div>`;sub='這座城市是哪個國家的首都？';answer=c.name;label='🗺️ 國家辨認'}
return {prompt,sub,answer,label,type}}
function renderQuestion(){locked=false;current=deck[index];const q=makeQuestion(current);$('counter').textContent=(index+1)+' / '+deck.length;$('score').textContent=score;$('streak').textContent=streak+' 🔥';$('bar').style.width=(index/deck.length*100)+'%';$('qLabel').textContent=q.label;$('prompt').innerHTML=q.prompt+'<div class="prompt-sub">'+q.sub+'</div>';$('feedback').className='feedback';$('feedback').textContent='';$('next').classList.remove('show');$('next').textContent=index===deck.length-1?'查看成績 🏆':'下一題 →';
let distractors=shuffle(COUNTRIES.filter(x=>x.code!==current.code)).slice(0,3).map(x=>q.type==='capital'?x.capital:x.name);let options=shuffle([q.answer,...distractors]);$('answers').innerHTML='';
options.forEach(opt=>{let b=document.createElement('button');b.className='answer';b.textContent=opt;b.addEventListener('click',()=>choose(b,opt,q.answer,q.type));$('answers').appendChild(b)})}
function choose(btn,choice,answer,type){if(locked)return;locked=true;const ok=choice===answer;document.querySelectorAll('.answer').forEach(b=>{b.disabled=true;if(b.textContent===answer)b.classList.add('correct')});if(!ok){btn.classList.add('wrong');streak=0;wrong.push({country:current.name,question:type==='flag'?'國旗辨認':type==='capital'?'首都挑戰':'國家辨認',given:choice,answer})}else{correct++;streak++;score+=difficulty==='easy'?10:difficulty==='normal'?15:20}
$('score').textContent=score;$('streak').textContent=streak+' 🔥';const fb=$('feedback');fb.className='feedback show '+(ok?'good':'bad');fb.innerHTML=ok?'✨ 答對了！太棒了！':`💡 再記一下！正確答案是：<b>${answer}</b>`;$('next').classList.add('show')}
$('next').addEventListener('click',()=>{if(!locked)return;index++;if(index>=deck.length)finish();else renderQuestion()});
function finish(){clearInterval(timerId);$('playing').classList.add('hidden');$('results').classList.remove('hidden');let elapsed=Math.floor((Date.now()-startAt)/1000),pct=Math.round(correct/deck.length*100),points=Math.round(correct/deck.length*100);$('finalScore').textContent=points+' 分';$('correctCount').textContent=correct+' / '+deck.length;$('accuracy').textContent=pct+'%';$('duration').textContent=formatTime(elapsed);$('trophy').textContent=pct===100?'👑':pct>=80?'🏆':pct>=60?'🥇':'🌱';$('resultTitle').textContent=pct===100?'太神啦！滿分通關！':pct>=80?'地理達人！':'冒險完成！';$('resultSub').textContent=pct>=80?'你的世界地理知識非常棒！再挑戰更高難度吧！':'每一次練習都會讓你更進步，繼續加油！';
try{let best=JSON.parse(localStorage.getItem('geoQuestBest')||'{}');let key=selectedMode+'_'+difficulty;if(!best[key]||points>best[key])best[key]=points;localStorage.setItem('geoQuestBest',JSON.stringify(best))}catch(e){}
$('review').innerHTML=wrong.length?'<h3>📚 錯題回顧（'+wrong.length+' 題）</h3>'+wrong.map(w=>`<div class="wrong-item"><span>${w.question} · ${w.country}<br><small style="color:#888">你的答案：${w.given}</small></span><b>正解：${w.answer}</b></div>`).join(''):'<h3>🎉 全部答對，沒有錯題！</h3>'}
$('start').addEventListener('click',startGame);$('retry').addEventListener('click',startGame);$('homeBtn').addEventListener('click',()=>{$('results').classList.add('hidden');$('home').classList.remove('hidden')});
</script>
</body></html>
