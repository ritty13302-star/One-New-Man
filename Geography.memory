"TG", "name": "多哥", "en": "Togo", "capital": "Lomé"}, {"code": "DO", "name": "多明尼加共和國", "en": "Dominican Republic", "capital": "Santo Domingo"}, {"code": "DM", "name": "多米尼克", "en": "Dominica", "capital": "Roseau"}, {"code": "NG", "name": "奈及利亞", "en": "Nigeria", "capital": "Abuja"}, {"code": "AT", "name": "奧地利", "en": "Austria", "capital": "Vienna"}, {"code": "VE", "name": "委內瑞拉", "en": "Venezuela", "capital": "Caracas"}, {"code": "BD", "name": "孟加拉", "en": "Bangladesh", "capital": "Dhaka"}, {"code": "AO", "name": "安哥拉", "en": "Angola", "capital": "Luanda"}, {"code": "AG", "name": "安地卡及巴布達", "en": "Antigua and Barbuda", "capital": "Saint John's"}, {"code": "AI", "name": "安奎拉", "en": "Anguilla", "capital": "The Valley"}, {"code": "HN", "name": "宏都拉斯", "en": "Honduras", "capital": "Tegucigalpa"}, {"code": "FM", "name": "密克羅尼西亞", "en": "Federated States of Micronesia", "capital": "Palikir"}, {"code": "LA", "name": "寮國", "en": "Laos", "capital": "Vientiane"}, {"code": "ZM", "name": "尚比亞", "en": "Zambia", "capital": "Lusaka"}, {"code": "NI", "name": "尼加拉瓜", "en": "Nicaragua", "capital": "Managua"}, {"code": "NE", "name": "尼日", "en": "Niger", "capital": "Niamey"}, {"code": "NP", "name": "尼泊爾", "en": "Nepal", "capital": "Kathmandu"}, {"code": "BS", "name": "巴哈馬", "en": "The Bahamas", "capital": "Nassau"}, {"code": "PK", "name": "巴基斯坦", "en": "Pakistan", "capital": "Islamabad"}, {"code": "PG", "name": "巴布亞紐幾內亞", "en": "Papua New Guinea", "capital": "Port Moresby"}, {"code": "PY", "name": "巴拉圭", "en": "Paraguay", "capital": "Asunción"}, {"code": "PA", "name": "巴拿馬", "en": "Panama", "capital": "Panama City"}, {"code": "BH", "name": "巴林", "en": "Bahrain", "capital": "Manama"}, {"code": "BR", "name": "巴西", "en": "Brazil", "capital": "Brasília"}, {"code": "BB", "name": "巴貝多", "en": "Barbados", "capital": "Bridgetown"}, {"code": "BF", "name": "布吉納法索", "en": "Burkina Faso", "capital": "Ouagadougou"}, {"code": "GR", "name": "希臘", "en": "Greece", "capital": "Athens"}, {"code": "PW", "name": "帛琉", "en": "Palau", "capital": "Ngerulmud"}, {"code": "GN", "name": "幾內亞", "en": "Guinea", "capital": "Conakry"}, {"code": "GW", "name": "幾內亞比索", "en": "Guinea-Bissau", "capital": "Bissau"}, {"code": "CK", "name": "庫克群島", "en": "Cook Islands", "capital": "Avarua"}, {"code": "DE", "name": "德國", "en": "Germany", "capital": "Berlin"}, {"code": "EE", "name": "愛沙尼亞", "en": "Estonia", "capital": "Tallinn"}, {"code": "IE", "name": "愛爾蘭", "en": "Ireland", "capital": "Dublin"}, {"code": "TK", "name": "托克勞群島", "en": "Tokelau", "capital": "Fakaofo"}, {"code": "LV", "name": "拉脫維亞", "en": "Latvia", "capital": "Riga"}, {"code": "NO", "name": "挪威", "en": "Norway", "capital": "Oslo"}, {"code": "SJ", "name": "挪威屬斯瓦巴及尖棉", "en": "Svalbard and Jan Mayen", "capital": "Longyearbyen"}, {"code": "CZ", "name": "捷克", "en": "Czech Republic", "capital": "Prague"}, {"code": "MA", "name": "摩洛哥", "en": "Morocco", "capital": "Rabat"}, {"code": "MD", "name": "摩爾多瓦", "en": "Moldova", "capital": "Chișinău"}, {"code": "MC", "name": "摩納哥", "en": "Monaco", "capital": "Monaco"}, {"code": "SY", "name": "敘利亞", "en": "Syria", "capital": "Damascus"}, {"code": "FJ", "name": "斐濟", "en": "Fiji", "capital": "Suva"}, {"code": "SK", "name": "斯洛伐克", "en": "Slovakia", "capital": "Bratislava"}, {"code": "SI", "name": "斯洛維尼亞", "en": "Slovenia", "capital": "Ljubljana"}, {"code": "LK", "name": "斯里蘭卡", "en": "Sri Lanka", "capital": "Colombo"}, {"code": "SG", "name": "新加坡", "en": "Singapore", "capital": "Singapore"}, {"code": "NC", "name": "新喀里多尼亞", "en": "New Caledonia", "capital": "Nouméa"}, {"code": "JP", "name": "日本", "en": "Japan", "capital": "Tokyo"}, {"code": "CL", "name": "智利", "en": "Chile", "capital": "Santiago"}, {"code": "IM", "name": "曼島", "en": "Isle of Man", "capital": "Douglas"}, {"code": "TO", "name": "東加", "en": "Tonga", "capital": "Nuku'alofa"}, {"code": "TL", "name": "東帝汶", "en": "East Timor", "capital": "Dili"}, {"code": "TD", "name": "查德", "en": "Chad", "capital": "N'Djamena"}, {"code": "K